+    if (!file || file.extension !== "md") throw new Error("대상 Markdown을 찾지 못했습니다.");
+    if (typeof app.fileManager.processFrontMatter !== "function") throw new Error("Frontmatter API를 사용할 수 없습니다.");
+    const now = new Date();
+    const pad = (n) => String(n).padStart(2, "0");
+    const stamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
+    await app.fileManager.processFrontMatter(file, (fm) => {
+      if (typeof fm["제목"] !== "string" || fm["제목"].includes(String.fromCharCode(60, 37))) throw new Error("Templater 원본이 아닌 생성된 문서에서 실행해 주세요.");
+      if (fm["문서유형"] !== "entity" || fm["세부유형"] !== "region") throw new Error("지역 실문서에서만 갱신할 수 있습니다.");
+      if (!["draft", "provisional", "canon", "archival"].includes(fm["정본상태"])) throw new Error("문서 상태를 먼저 확인해 주세요.");
+      fm["최종수정일"] = stamp;
+    });
+    status.textContent = ` 갱신 완료: ${stamp}`;
+  } catch (error) {
+    status.textContent = ` 갱신하지 못했습니다: ${error?.message ?? String(error)}`;
+    console.error("[지역 V2 수정일]", error);
+  } finally {
+    button.disabled = false;
+  }
 };
